{
  "env": {
    "EDITOR": "nvim"
  },
  "editorMode": "vim",
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Read(~/.zshrc)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true
  },
  "theme": "dark",
  "tui": "fullscreen"
}
